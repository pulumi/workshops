+# --- Intentional over-broad binding (workshop step 6) ---
+# Applied by 06-over-broad-binding/widen-service-account-to-project-owner.patch.
+# This grants the service account project-level Owner, at the project scope
+# rather than scoped to this one service account - exactly the mistake the
+# policy pack in 05-policy-pack/ is written to catch. `pulumi preview` (and
+# `pulumi up`) must be blocked by the "gcp-iam-binding-stays-scoped" policy
+# once this hunk is applied and the policy pack is running locally
+# (`pulumi preview --policy-pack ../05-policy-pack`).
+project = gcp.organizations.get_project()
+
+owner_binding = gcp.projects.IAMMember(
+    "service-account-project-owner",
+    project=project.project_id,
+    role="roles/owner",
+    member=pulumi.Output.concat("serviceAccount:", service_account.email),
+)
+
+pulumi.export("overBroadBindingRole", owner_binding.role)
