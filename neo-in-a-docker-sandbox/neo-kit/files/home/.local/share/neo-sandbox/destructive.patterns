# neo-sandbox guard patterns — one `tool|extended-regex` per line, `*` = any tool.
# The regex is matched against the space-joined argument line of the command.
# Kept deliberately short: the goal is to stop accidents, not to enumerate AWS.

# Pulumi: anything that deletes resources, stacks, state or environments
pulumi|^(destroy|down)([[:space:]]|$)
pulumi|^dn([[:space:]]|$)
pulumi|^stack[[:space:]]+(rm|remove|delete)([[:space:]]|$)
pulumi|^state[[:space:]]+(delete|unprotect)([[:space:]]|$)
pulumi|^(env|esc)[[:space:]]+(rm|remove|delete)([[:space:]]|$)
pulumi|^cancel([[:space:]]|$)
pulumi|(^|[[:space:]])--(remove|target-replace)([[:space:]]|=|$)

# AWS CLI: s3 rb/rm and every delete-/terminate-/deregister-/purge- style verb
aws|(^|[[:space:]])s3[[:space:]]+(rb|rm)([[:space:]]|$)
aws|(^|[[:space:]])(delete|terminate|deregister|purge|remove|disassociate|detach)-[a-z0-9-]+([[:space:]]|$)

# Terraform / OpenTofu
terraform|^(destroy|taint|force-unlock)([[:space:]]|$)
terraform|^apply[[:space:]].*-destroy
terraform|^state[[:space:]]+(rm|mv|push|replace-provider)([[:space:]]|$)
terraform|^workspace[[:space:]]+delete([[:space:]]|$)
tofu|^(destroy|taint|force-unlock)([[:space:]]|$)
tofu|^apply[[:space:]].*-destroy
tofu|^state[[:space:]]+(rm|mv|push|replace-provider)([[:space:]]|$)
tofu|^workspace[[:space:]]+delete([[:space:]]|$)
