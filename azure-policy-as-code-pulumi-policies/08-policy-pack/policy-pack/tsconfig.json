{
  "compilerOptions": {
    "strict": true,
    "outDir": "dist",
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "index.ts",
    "rule.ts",
    "test/*.ts"
  ]
}
